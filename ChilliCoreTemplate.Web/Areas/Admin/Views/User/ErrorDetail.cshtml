@model ErrorLogExpandedModel
@{
    Layout = null;
    var heading = "Error details";
    if (Model.Properties.ContainsKey("RequestUrl")) { heading = Model.Properties["RequestUrl"].ToString(); }
    else if (Model.Properties.ContainsKey("ExceptionMessage")) { heading = Model.Properties["ExceptionMessage"].ToString(); }
}
<div class="modal-body">
    <h4 class="mb-4">@heading</h4>
    <table-default>
        <thead class="table-light">
            <tr>
                <th>Property</th>
                <th>Value</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.GetFlattenProperties())
            {
                <tr>
                    <td>
                        @for (var i = 0; i < item.Level; i++)
                        {
                            <i class="bi bi-chevron-right"></i>
                        }
                        @item.Property
                    </td>
                    <td style="white-space: pre-line">@item.Value</td>
                </tr>
            }
            <tr>
                <td>Stack trace</td>
                <td style="white-space: pre-line">@Model.Exception</td>
            </tr>
        </tbody>
    </table-default>
</div>
<div class="modal-footer">
    <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>