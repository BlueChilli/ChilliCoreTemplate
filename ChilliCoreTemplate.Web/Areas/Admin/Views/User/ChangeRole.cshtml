@model ChangeAccountRoleModel
@using (Html.BeginFormCustom(Mvc.Admin.User_ChangeRole, new { @class = "d-flex flex-column h-full" }))
{
    <div class="offcanvas-header border-bottom bg-surface-secondary">
        <h5 class="offcanvas-title">Manage</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        @Html.ValidationSummary()
        @Html.HiddenFor(m => m.Id)

        <table-default class="js-table">
            <thead class="table-light">
                <tr>
                    <th>Role</th>
                    <th>Partner</th>
                    <th>
                        <button mvc-modal="@Mvc.Admin.User_AddRole" asp-route-id="@Model.Id" icon="Create" icon-placement="Left">Add role</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model.CurrentRoles)
                {
                    <tr>
                        <td>@role.Role.GetDescription()</td>
                        <td>@role.CompanyName</td>
                        <td>
                            <button mvc-modal="Mvc.Admin.User_RemoveRole" asp-route-id="@Model.Id" asp-route-role="@role.Role" icon="Delete"></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table-default>


    </div>
    <div class="d-flex p-4 bg-surface-secondary w-full">
        <div class="ms-auto">
            @await Html.ButtonAsync(FieldTemplateHelper.ButtonOffCanvasDismissOptions)
        </div>
    </div>
}