@model ResetPasswordViewModel
@using (Html.BeginFormCustom(Mvc.Admin.User_ResetPassword))
{
    <div class="modal-body">
        @Html.ValidationSummary()
        @Html.HiddenFor(m => m.Id)
        @Html.HiddenFor(m => m.UserId)
        @Html.HiddenFor(m => m.Token)

        @await Html.FieldTemplateForAsync(m => m.NewPassword, options: new TemplateOptions { Template = FieldTemplateLayouts.ModalField }, fieldOptions: new FieldTemplateOptions { HtmlAttributes = new { autofocus = "autofocus", autocomplete="new-password" } })
        @await Html.FieldTemplateForAsync(m => m.ConfirmPassword, options: new TemplateOptions { Template = FieldTemplateLayouts.ModalField }, fieldOptions: new FieldTemplateOptions { HtmlAttributes = new { autocomplete="new-password" } })
    </div>
    <div class="modal-footer">
        @await Html.ButtonSubmitAsync("Submit")
        @await Html.ButtonAsync(FieldTemplateHelper.ButtonModalDismissOptions)
    </div>
}
@Html.RenderCustomSection("scripts")
<script>
    $('#@Mvc.Admin.User_ResetPassword.GetFormId()').ajaxForm({ target: '#@Mvc.Admin.User_ResetPassword.GetModalId()_content' });
</script>
