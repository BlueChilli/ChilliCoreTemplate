@model UserRemoveRoleModel
@using (Html.BeginFormCustom(Mvc.Admin.User_RemoveRole, htmlAttributes: new { @class = "form-horizontal" }))
{
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.Role)
    <div class="modal-body">
        @Html.ValidationSummary()
        <p>Are you sure you want remove the role <b>@Model.Role.GetDescription()?</b></p>
    </div>
    <div class="modal-footer">
        @await Html.ButtonSubmitAsync(new Template_Button { Style = ButtonStyle.Danger, Text = $"Yes, remove this role" })
        @await Html.ButtonAsync(FieldTemplateHelper.ButtonModalDismissOptions)
    </div>
}
<script>
    $('#@Mvc.Admin.User_RemoveRole.GetFormId()').ajaxForm({ target: '#@Mvc.Admin.User_RemoveRole.GetModalId()_content' }).done(function () {
        @Mvc.Admin.User_ChangeRole.OffCanvasOpen(Html, Model.Id);
        $('#@Mvc.Admin.User_RemoveRole.GetModalId()').modal('hide');
    });
</script>