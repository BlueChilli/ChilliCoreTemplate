@model IFieldInnerTemplateModel<ReadonlyFieldTemplateOptions>
@{
    Model.HtmlAttributes.Merge("class", "form-control");
    Model.HtmlAttributes.Merge("class", "form-control-readonly");
}
@if (Model.Options.PreAddOn != null || Model.Options.PostAddOn != null)
{
    @:<div class="input-group">
}
@if (Model.Options.PreAddOn != null)
{
    @Model.Options.PreAddOn
}
<input type="text" readonly id="@Model.Id" value="@Model.Value" @Model.HtmlAttributes.ToAttributeHtmlContent()>
@if (Model.Options.PostAddOn != null)
{
    @Model.Options.PostAddOn
}
@if (Model.Options.PreAddOn != null || Model.Options.PostAddOn != null)
{
    @:</div>
}