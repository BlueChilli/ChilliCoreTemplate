@model IFieldInnerTemplateModel<PasswordFieldTemplateOptions>
@{
    Model.HtmlAttributes.Merge("class", "form-control");
}
<div class="input-group">
    <input id="@Model.Id" name="@Model.Name" @Model.HtmlAttributes.ToAttributeHtmlContent()>
    <span class="input-group-text"><i class="bi bi-eye js-password-mask"></i></span>
</div>
@if (Model.Options.AutoWireUpJavascript)
{
    var key = new Guid("c6c49cd6-5c4f-4598-abdb-fd9c693a4aa5");
    @Html.RegisterCustomSection("scripts", key,
    @<script>
        $(function () {
            $('.js-password-mask').click(BlueChilli.passwordMask);
        });
    </script>
    )
}
