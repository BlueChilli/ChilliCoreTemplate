@model ResetPasswordViewModel
<h2 class="mb-10">Set password for @Model.Email</h2>
@using (Html.BeginFormCustom(Mvc.Root.EmailAccount_ConfirmInvite))
{
    @Html.ValidationSummary()
    @Html.HiddenFor(model => model.Token)
    @Html.HiddenFor(model => model.Email)

    @await Html.FieldTemplateInnerForAsync(m => m.NewPassword, new FloatingFieldTemplateOptions { HtmlAttributes = new { autofocus = "autofocus" } })
    @await Html.FieldTemplateInnerForAsync(m => m.ConfirmPassword, new FloatingFieldTemplateOptions())

    <div class="d-grid gap-1">
        <button type="submit" class="btn btn-primary">Set my Password</button>
        @await Html.ButtonAsync(Mvc.Root.EmailAccount_Login, new Template_Button { Text = "Cancel", Style = ButtonStyle.Secondary, Size = ButtonSize.Medium })
    </div>
}
