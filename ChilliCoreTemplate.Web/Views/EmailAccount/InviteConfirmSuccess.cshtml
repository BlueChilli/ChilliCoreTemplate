@model RegistrationCompleteViewModel

<h3>Invitation accepted</h3>
<alert type="Info" class="mt-4">
    <alert-title>Your invitation has been successfully accepted</alert-title>
    <a href="@Mvc.Root.EmailAccount_Login.Url(this.Url, routeValues: new { Model.Email })" title="click here to login" class="alert-link">Click here</a> to login
</alert>
