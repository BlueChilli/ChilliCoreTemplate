@model ResetPasswordViewModel
@inject ProjectSettings config

<h2 class="mb-10">Password reset</h2>
<div class="alert alert-info">
    <p class="alert">Your password has been successfully reset.</p>
    <p class="alert" condition="Model.IsMobile">Go back to the app to continue to use @config.ProjectDisplayName.</p>
    <p class="alert" condition="Model.IsMobile"><a href="#" class="btn btn-primary" onclick="launchApp()">Launch @config.ProjectDisplayName</a></p>
    <p class="alert" condition="!Model.IsMobile"><a mvc-action="@Mvc.Root.EmailAccount_Login.AddRouteValues(new { Email = Model.Email })" title="click here to login" class="alert-link">Click here</a> to login</p>
</div>
@section Scripts
{
    <script condition="Model.IsMobile">
        function launchApp() {
            window.location = '@config.MobileSettings.DeepLink';
            setTimeout(function () { window.location = '@Mvc.Root.Public_DownloadApp.Url(Url)'; }, 100);
        }
    </script>
}