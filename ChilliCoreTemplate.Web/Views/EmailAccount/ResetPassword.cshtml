@model ResetPasswordViewModel
<h2 class="mb-10">Reset Password for @Model.Email</h2>
@using (Html.BeginFormCustom(Mvc.Root.EmailAccount_ResetPassword))
{
    @Html.ValidationSummary()
    @Html.HiddenFor(model => model.Token)
    @Html.HiddenFor(model => model.Email)
    @Html.HiddenFor(model => model.IsApi)

    @await Html.FieldTemplateInnerForAsync(m => m.NewPassword, new FloatingFieldTemplateOptions { HtmlAttributes = new { autofocus = "autofocus" }, PostAddOn = FieldTemplateOptions.IconAddOn(IconType.View, "js-password-mask") })
    @await Html.FieldTemplateInnerForAsync(m => m.ConfirmPassword, new FloatingFieldTemplateOptions { PostAddOn = FieldTemplateOptions.IconAddOn(IconType.View, "js-password-mask") })

    <div class="d-grid gap-1">
        <button type="submit" class="btn btn-primary">Reset my Password</button>
        @await Html.ButtonAsync(Mvc.Root.EmailAccount_Login, new Template_Button { Text = "Cancel", Style = ButtonStyle.Neutral, Size = ButtonSize.Medium })
    </div>
}
@section scripts
{
    <script>
        $(function () {
            $('.js-password-mask').click(BlueChilli.passwordMask);
        });
    </script>
}