@model string
@{
    ViewData["WideScreen"] = true;
}
<img class="mb-6 d-block mx-auto" src="@Url.Content("~/images/icons/email-sent.svg")" width="100" />
<h3 class="mb-6">Registration successful</h3>
<box>
    <box-content>
        <h5 class="mb-2">Next steps</h5>
        <p>You’re nearly done! To finish your registration, please verify your email. We've sent a verification email to <strong>@Model</strong> - just check your inbox and click the "Verify email address" button to confirm your address and start onboarding.</p>
        <h5 class="mt-4 mb-2">Didn’t get the email?</h5>
        <p>Please check your inbox, and if it doesn't arrive soon, check your spam folder. You can also <a mvc-action="Mvc.Root.EmailAccount_Login" asp-route-email="@Model">sign in here</a> to request a new email.</p>
    </box-content>
</box>