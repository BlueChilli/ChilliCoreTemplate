@model string
@{
    ViewData["WideScreen"] = true;
}
<h3 class="mb-4">Registration successful</h3>
<alert type="Success">
    <alert-title>Next steps</alert-title>
    <p>We have sent a verification email to @Model.</p>
    <p>Click the link within to complete your online registration.</p>
    <p>If you don't receive the email within 5 minutes, check your spam. You can get a verification email resent by signing in.</p>
</alert>