@model RazorTemplateDataModel<InviteEditModel>
@inject ProjectSettings config
@{
    Layout = "~/Views/Emails/_MjmlLayout.cshtml";
    var joining = Model.Data.InviteRole.CompanyName ?? Model.Site;
    var isCompanyInvite = Model.Data.InviteRole.CompanyId.HasValue;
    Model.Subject = isCompanyInvite ? $"You have been invited to the {Model.Site} portal for {joining}" : $"You have been invited to join {joining}";
    Model.Title = String.Format("You've been invited as a {0} for {1}", Model.Data.InviteRole.Role.Value.GetDescription(), joining);
    Model.EmailPreview = "Inside are instructions to access your account";

    var data = new UserTokenModel { Email = Model.Data.Email, Token = Model.Data.Token }.ToTokenModel();
    var url = Model.Data.InviteRole.Role.Value.HasFlag(Role.User)
        ? config.ResolveUrl("~/users/acceptInvite", data)
        : Mvc.Root.EmailAccount_ConfirmInvite.Url(this.Url, routeValues: data, protocol: "https");

    var forgotPasswordUrl = Model.Data.InviteRole.Role.Value.HasFlag(Role.User)
        ? config.ResolveUrl("~/users/forgot-password", new { Email = Model.Data.Email })
        : Mvc.Root.EmailAccount_ForgotPassword.Url(this.Url, routeValues: new { Email = Model.Data.Email }, protocol: "https");

    var builder = EmailBuilder.CreateDefault(this.Html, EmailConstants.EmailOptions);
}
<mj-section background-color="#FFFFFF" padding="48px 0 0 0">
    <mj-column>
        <mj-text mj-class="paragraph">
            Hi @Model.Data.FirstName,
        </mj-text>
        <mj-text mj-class="paragraph">
            @if (String.IsNullOrEmpty(Model.Data.Inviter))
            {
                <text>You're receiving this email because you have been invited to @joining.</text>
            }
            else
            {
                <text>You're receiving this email because @Model.Data.Inviter has invited you to @joining.</text>
            }
        </mj-text>
        <mj-text mj-class="paragraph">
            To set your password and start using @Model.Site click on the button below.
        </mj-text>
        <mj-button mj-class="btn" href="@builder.UrlTrack(Model.TrackingId, Model.TemplateId, url)">Set password</mj-button>
        <mj-text mj-class="paragraph">
            For your security, this link expires in 7 days, so if you've taken longer than that, click <a target="_blank" href="@forgotPasswordUrl">here</a> to receive a reset password email.
        </mj-text>
    </mj-column>
</mj-section>