@model RazorTemplateDataModel<RegistrationCompleteViewModel>
@inject ProjectSettings config
@{
    Layout = "~/Views/Emails/_MjmlLayout.cshtml";
    Model.Subject = $"Complete your {Model.CompanyName} sign up";
    Model.Title = $"Welcome to {Model.CompanyName}";
    Model.EmailPreview = config.UserConfirmationMethod == UserConfirmationMethod.Link ? "please verify your email address" : "please read the onboarding instructions carefully";
    var builder = EmailBuilder.CreateDefault(this.Html, EmailConstants.EmailOptions);
    var data = new UserTokenModel { Email = Model.Data.Email, Token = Model.Data.Token }.ToTokenModel();
    var url = Model.IsApi
        ? config.ResolveUrl("~/account/confirmemail", data)
        : Mvc.Root.EmailAccount_RegistrationComplete.Url(this.Url, routeValues: data, protocol: "https");
}
<mj-section background-color="#FFFFFF" padding="48px 0">
    <mj-column>
        <mj-text mj-class="paragraph">
            Hi @Model.Data.FirstName,
        </mj-text>
        <mj-text mj-class="paragraph">
            Thank you for signing up to @Model.Site.
        </mj-text>
        <mj-text mj-class="paragraph">
            To get started, verify your email below.
        </mj-text>
        <mj-button mj-class="btn" href="@builder.UrlTrack(Model.TrackingId, Model.TemplateId, url)">Verify email address</mj-button>
    </mj-column>
</mj-section>