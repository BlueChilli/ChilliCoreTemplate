@model RazorTemplateDataModel<string>
@inject ProjectSettings config
@{
    Layout = "~/Views/Emails/_MjmlLayout.cshtml";
    Model.Subject = @"Your email address is not registered";
    Model.Title = "Your email address is not registered";
    Model.EmailPreview = "Are you sure you're using the correct email address?";
    var builder = EmailBuilder.CreateDefault(this.Html, EmailConstants.EmailOptions);
    var loginUrl = Mvc.Root.EmailAccount_Login.Url(this.Url, protocol: "https");
    var emailSection = config.EmailTemplate;
}
<mj-section background-color="#FFFFFF" padding="48px 0">
    <mj-column>
        <mj-text>
            <h2>You may not be using the correct email address to sign in.</h2>
        </mj-text>
        <mj-text mj-class="paragraph">
            You're receiving this message because your email address @Model.Data was used to login to @Model.CompanyName, but no account exists for that email address.
        </mj-text>
        <mj-text mj-class="paragraph">
            You might have typed your email address in wrong, in which case you can try signing in again by clicking the button below.
        </mj-text>
        <mj-button mj-class="btn" href="@builder.UrlTrack(Model.TrackingId, Model.TemplateId, loginUrl)">Sign in</mj-button>
        <mj-text mj-class="paragraph">
            If you did not try signing in, then you can email us at @emailSection.Email or simply disregard this email.
        </mj-text>
    </mj-column>
</mj-section>